<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VitalTrack - Cuida tus datos</title>
    <link rel="stylesheet" href="~/css/estilos.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
    <nav class="navbar">
        <a class="logo" asp-controller="Home" asp-action="Index" style="text-decoration: none;">💙 VitalTrack</a>
        <ul class="nav-links">
            <li><a asp-controller="Home" asp-action="Index">Inicio</a></li>
            <li><a asp-controller="Home" asp-action="Panel">Mi salud</a></li>
            <li><a asp-controller="Home" asp-action="Registrar">Registrar</a></li>
            <li><a asp-controller="Home" asp-action="Historial">Historial</a></li>
            <li><a asp-controller="Home" asp-action="Recomendaciones">Recomendaciones</a></li>
            <li><a asp-controller="Home" asp-action="Acerca">Acerca de</a></li>
        </ul>
    </nav>

    <main class="container">
        @RenderBody()
    </main>

    <script src="~/js/app.js"></script>
